# Runtime variables for one independently provisioned site.
# Prefer: cp site.manifest.example.json site.manifest.json, fill it, then run
# pnpm site:provision -- --manifest site.manifest.json
# Never commit .env or a filled site manifest.
SITE_PROVISION_MODE="independent"
SITE_URL="https://www.example.com"
DEPLOY_ADAPTER="node"

# A NEW Tina Cloud project for an independent clone.
NEXT_PUBLIC_TINA_CLIENT_ID="replace-with-new-tina-client-id"
TINA_TOKEN="replace-with-new-tina-read-token"
NEXT_PUBLIC_TINA_BRANCH="main"
NEXT_PUBLIC_TINA_CONTENT_API_URL="https://www.example.com/tina-content-proxy"

# The NEW repository connected to the Tina project.
GITHUB_CONTENT_REPO="owner/new-repository"

# A dedicated Cloudinary account, or at minimum a unique folder for this site.
CLOUDINARY_CLOUD_NAME="replace-with-site-cloud-name"
CLOUDINARY_API_KEY="replace-with-site-api-key"
CLOUDINARY_API_SECRET="replace-with-site-api-secret"
CLOUDINARY_ROOT_FOLDER="unique-site-slug"
