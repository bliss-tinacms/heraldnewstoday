---
import { tinaField } from '@tinacms/astro/tina-field';
import { getBlogPermalink } from '../lib/permalinks';
import type { CmsBlog, CmsConfig } from '../lib/data';
type Post = CmsBlog;
interface Props { posts: Post[]; config?: CmsConfig | null; data?: any; editData?: any; }
const { posts, data, editData } = Astro.props;
const blocks = Array.isArray(data?.blocks) ? data.blocks : [];
const editBlocks = Array.isArray(editData?.blocks) ? editData.blocks : [];
const isHomepage = (block: any) => block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate';
const homepage = blocks.find(isHomepage) ?? {};
const editHomepage = editBlocks.find(isHomepage) ?? homepage;
function tf(node: any, key: string) { try { return node ? tinaField(node, key) : undefined; } catch { return undefined; } }
function categories(post: any) { return Array.isArray(post?.categories) ? post.categories.map((item: any) => item?.category ?? item).filter(Boolean) : []; }
function refLabel(reference: any) { return typeof reference === 'string' ? reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') : reference?.title || reference?.name || ''; }
function postUrl(post: Post) { const url = getBlogPermalink(post); return url.endsWith('/') ? url : `${url}/`; }
const hero = homepage.hero ?? {}, why = homepage.why ?? {}, newsroom = homepage.newsroom ?? {}, wire = homepage.wireFeature ?? {}, coverage = homepage.coverage ?? {}, standards = homepage.standardsSection ?? {}, team = homepage.team ?? {};
const eHero = editHomepage.hero ?? hero, eWhy = editHomepage.why ?? why, eNewsroom = editHomepage.newsroom ?? newsroom, eWire = editHomepage.wireFeature ?? wire, eCoverage = editHomepage.coverage ?? coverage, eStandards = editHomepage.standardsSection ?? standards, eTeam = editHomepage.team ?? team;
const topics = Array.isArray(coverage.topics) ? coverage.topics : [];
const values = Array.isArray(why.standards) ? why.standards : [];
const processItems = Array.isArray(standards.items) ? standards.items : [];
const people = Array.isArray(team.people) ? team.people : [];
const featuredPosts = posts.slice(0, 3);
const heroTitle = String(hero.title || '').trim();
const heroWords = heroTitle.split(/\s+/);
const heroAccent = heroWords.pop() || '';
const heroLead = heroWords.join(' ');
---
<main class="ffn-home lock-home">
  <section class="lock-hero" style={hero.image ? `background-image:url('${hero.image}')` : undefined} aria-labelledby="home-title" data-tina-field={tf(eHero, 'image')}>
    <div class="lock-hero-copy"><div class="lock-pill" data-tina-field={tf(eHero, 'eyebrow')}>●&nbsp; {hero.eyebrow}</div><h1 id="home-title" data-tina-field={tf(eHero, 'title')}>{heroLead} <span>{heroAccent}</span></h1><p data-tina-field={tf(eHero, 'description')}>{hero.description}</p></div>
  </section>

  <section class="lock-section lock-coverage"><div class="w">
    <div class="eye"><i></i><span data-tina-field={tf(eCoverage, 'eyebrow')}>{coverage.eyebrow}</span></div><div class="lock-section-heading"><h2 data-tina-field={tf(eCoverage, 'title')}>{coverage.title}</h2><p class="lock-intro" data-tina-field={tf(eCoverage, 'description')}>{coverage.description}</p></div>
    <div class="lock-topic-grid">{topics.map((item: any, index: number) => { const editItem = eCoverage?.topics?.[index] ?? item; return <a class="lock-topic" href={item.link || '/blog/'}><div class="lock-topic-image">{item.image && <img src={item.image} alt={item.imageAlt || ''} data-tina-field={tf(editItem, 'image')} />}<b data-tina-field={tf(editItem, 'number')}>{item.number}</b><span>↗</span></div><h3 data-tina-field={tf(editItem, 'title')}>{item.title}</h3><p data-tina-field={tf(editItem, 'text')}>{item.text}</p></a>; })}</div>
  </div></section>

  <section class="lock-section lock-about"><div class="w"><div class="lock-about-panel"><div class="lock-pill" data-tina-field={tf(eWhy, 'eyebrow')}>●&nbsp; {why.eyebrow}</div><h2 data-tina-field={tf(eWhy, 'title')}>{why.title}</h2><p class="lock-about-copy" data-tina-field={tf(eWhy, 'paragraphOne')}>{why.paragraphOne}</p><div class="lock-value-grid">{values.map((item: any, index: number) => { const editItem = eWhy?.standards?.[index] ?? item; return <div class="lock-value"><small data-tina-field={tf(editItem, 'label')}>{item.label}</small><h3 data-tina-field={tf(editItem, 'title')}>{item.title}</h3><p data-tina-field={tf(editItem, 'text')}>{item.text}</p></div>; })}</div></div></div></section>

  <section class="lock-section lock-stories"><div class="w"><div class="lock-story-heading"><div><div class="eye"><i></i><span data-tina-field={tf(eNewsroom, 'subheading')}>{newsroom.subheading}</span></div><h2 data-tina-field={tf(eNewsroom, 'heading')}>{newsroom.heading}</h2></div><a class="lock-view-all" href={newsroom.submitButtonLink || '/blog/'} data-tina-field={tf(eNewsroom, 'submitHeading')}>{newsroom.submitHeading} →</a></div><div class="lock-story-grid">{featuredPosts.map((post) => <a class="lock-story" href={postUrl(post)}>{post.heroImage && <img src={post.heroImage} alt="" />}<div>{categories(post).length > 0 && <div class="category-badges">{categories(post).map((category: any) => <span>{refLabel(category)}</span>)}</div>}<h3>{post.title}</h3>{post.description && <p>{post.description}</p>}</div></a>)}</div></div></section>

  <section class="lock-section lock-commitment"><div class="w"><div class="lock-commitment-panel">{wire.image && <img src={wire.image} alt={wire.imageAlt || ''} data-tina-field={tf(eWire, 'image')} />}<div class="lock-commitment-copy"><div class="lock-commitment-top"><div class="lock-pill dark" data-tina-field={tf(eWire, 'eyebrow')}>●&nbsp; {wire.eyebrow}</div><b class="lock-quote">“</b></div><blockquote data-tina-field={tf(eWire, 'quote')}>{wire.quote}</blockquote><div class="lock-by"><b data-tina-field={tf(eWire, 'author')}>{wire.author}</b><span data-tina-field={tf(eWire, 'byline')}>{wire.byline}</span></div></div></div></div></section>

  <section class="lock-section lock-process"><div class="w"><div class="lock-process-panel"><div class="lock-process-copy"><div class="eye"><i></i><span data-tina-field={tf(eStandards, 'eyebrow')}>{standards.eyebrow}</span></div><h2 data-tina-field={tf(eStandards, 'title')}>{standards.title}</h2><p class="lock-intro" data-tina-field={tf(eStandards, 'documentSubtitle')}>{standards.documentSubtitle}</p></div><div class="lock-process-list">{processItems.map((item: any, index: number) => { const editItem = eStandards?.items?.[index] ?? item; return <div class="lock-process-item"><b>{String(index + 1).padStart(2, '0')}</b><div><h3 data-tina-field={tf(editItem, 'title')}>{item.title}</h3><p data-tina-field={tf(editItem, 'text')}>{item.text}</p></div></div>; })}</div></div></div></section>

  <section class="lock-section lock-team"><div class="w"><div class="eye"><i></i><span data-tina-field={tf(eTeam, 'eyebrow')}>{team.eyebrow}</span></div><h2 data-tina-field={tf(eTeam, 'title')}>{team.title}</h2><div class="lock-team-grid">{people.map((person: any, index: number) => { const editPerson = eTeam?.people?.[index] ?? person; return <a href={person.link || '/our-team/'} class="lock-person">{person.image && <img src={person.image} alt={person.imageAlt || person.name || ''} data-tina-field={tf(editPerson, 'image')} />}<div><h3 data-tina-field={tf(editPerson, 'name')}>{person.name}</h3><b data-tina-field={tf(editPerson, 'role')}>{person.role}</b><p data-tina-field={tf(editPerson, 'bio')}>{person.bio}</p></div></a>; })}</div></div></section>
</main>
