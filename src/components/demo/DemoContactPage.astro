---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const formSection = block?.formSection || {};
const requests = block?.requests || {};
const requestCards = Array.isArray(requests?.cards) ? requests.cards : [];
const formAction = formSection.formAction || config?.contactForm?.formspreeEndpoint || '';
const formConfigured = /^https:\/\/formspree\.io\/f\/[A-Za-z0-9_-]+$/.test(formAction);
const heroHeadline = String(hero.headline || '').trim();
const heroAccentMatch = heroHeadline.match(/^(.*?)(the\s+newsroom\.?)(\s*)$/i);
const heroLead = heroAccentMatch?.[1]?.trimEnd() || heroHeadline;
const heroAccent = heroAccentMatch?.[2] || '';
---
<main class="ffn-demo ffn-demo-contact">
  <header class="ph"><div class="w"><div class="ph-in"><div class="ph-k" data-tina-field={tinaField(hero, 'eyebrow')}>{hero.eyebrow}</div><h1 data-tina-field={tinaField(hero, 'headline')}>{heroLead}{heroAccent && <> <span>{heroAccent}</span></>}</h1><p class="ph-d" data-tina-field={tinaField(hero, 'lede')}>{hero.lede}</p></div></div></header>
  <section class="sc contact-main"><div class="w contact-grid">
    <div class="contact-guide">
      <h2 class="contact-guide-title" data-tina-field={tinaField(requests, 'title')}>{requests.title}</h2>
      <p class="contact-guide-intro" data-tina-field={tinaField(requests, 'intro')}>{requests.intro}</p>
      <div class="contact-notes">
        {requestCards.map((card: any, index: number) => <div class="contact-note" data-open={index === 0 ? 'true' : 'false'}>
          <button type="button" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`contact-note-${index}`}><span data-tina-field={tinaField(card, 'title')}>{card.title}</span><i aria-hidden="true">+</i></button>
          <p id={`contact-note-${index}`} hidden={index !== 0} data-tina-field={tinaField(card, 'text')}>{card.text}</p>
        </div>)}
      </div>
    </div>
    <form class="contact-form" method="POST" action={formConfigured ? formAction : undefined}>
      <div class="contact-form-heading"><h2 data-tina-field={tinaField(formSection, 'formTitle')}>{formSection.formTitle}</h2>
      <p data-tina-field={tinaField(formSection, 'description')}>{formSection.description}</p></div>
      <input type="hidden" name="_subject" value={formSection.subject || config?.contactForm?.subject || ''} />
      <div class="contact-fields">
        <label class="fr"><span class="fl">Name</span><input class="fi" name="name" type="text" autocomplete="name" required /></label>
        <label class="fr"><span class="fl">Phone</span><input class="fi" name="phone" type="tel" autocomplete="tel" /></label>
        <label class="fr contact-email"><span class="fl">Email</span><input class="fi" name="email" type="email" autocomplete="email" required /></label>
        <label class="fr contact-message"><span class="fl">Message</span><textarea class="fi" name="message" rows="6" required></textarea></label>
      </div>
      <div class="contact-form-foot"><button type="submit" disabled={!formConfigured} aria-disabled={!formConfigured}><span data-tina-field={tinaField(formSection, 'buttonText')}>{formSection.buttonText}</span> <span aria-hidden="true">↗</span></button></div>
    </form>
  </div></section>
</main>

<script>
  document.querySelectorAll<HTMLElement>('.ffn-demo-contact .contact-note').forEach((note) => {
    const button = note.querySelector<HTMLButtonElement>(':scope > button');
    const panel = note.querySelector<HTMLElement>(':scope > p');
    button?.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      note.dataset.open = String(open);
      if (panel) panel.hidden = !open;
    });
  });
</script>

<style>
  .ffn-demo-contact .ph {
    padding: 28px 0 0 !important;
  }

  .ffn-demo-contact .ph > .w {
    max-width: 1256px !important;
  }

  .ffn-demo-contact .ph-in {
    padding: 72px !important;
  }

  .ffn-demo-contact .ph h1 {
    max-width: none !important;
    margin: 0 !important;
    font-size: clamp(44px, 7.2vw, 96px) !important;
    line-height: .98 !important;
  }

  .ffn-demo-contact .ph-d {
    max-width: none !important;
    font-size: 18px !important;
    line-height: 1.7 !important;
  }

  .ffn-demo-contact .ph-in { display:flex; flex-direction:column; gap:28px; padding:72px !important; }
  .ffn-demo-contact .ph-k { align-self:flex-start; width:max-content; display:inline-flex !important; align-items:center; gap:8px !important; margin:0 !important; padding:7px 14px !important; font:700 13px/1.2 var(--san) !important; }
  .ffn-demo-contact .ph-k::before { content:'●'; flex:none; font-size:8px; line-height:1; color:var(--green); }
  .ffn-demo-contact .ph h1 { margin:0 !important; width:100%; max-width:none !important; font:800 clamp(44px,7.2vw,96px)/.98 var(--san) !important; letter-spacing:-.045em !important; }
  .ffn-demo-contact .ph-d { margin:0 !important; width:100%; max-width:none !important; font:400 18px/1.7 var(--san) !important; color:#1f252d !important; }

  .ffn-demo-contact .contact-main {
    padding: clamp(48px, 6vw, 88px) 0 0 !important;
  }

  .ffn-demo-contact .contact-grid {
    width: 1256px;
    max-width: calc(100% - 64px) !important;
    display: flex !important;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 56px) !important;
    padding: 56px !important;
    border-radius: 36px !important;
  }

  .ffn-demo-contact .contact-guide { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .ffn-demo-contact .contact-guide-title,
  .ffn-demo-contact .contact-guide-intro { margin: 0 !important; }

  .ffn-demo-contact .contact-guide-title {
    font-size: clamp(32px, 3.8vw, 50px);
    line-height: 1.02 !important;
  }

  .ffn-demo-contact .contact-form h2 {
    font-size: clamp(28px, 3vw, 38px);
  }

  .ffn-demo-contact .contact-form {
    flex: 1.2 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 44px;
    border: 0;
    border-radius: 28px;
  }

  .ffn-demo-contact .contact-form-heading { display:flex; flex-direction:column; gap:8px; }
  .ffn-demo-contact .contact-form-heading > h2 { margin: 0 !important; }
  .ffn-demo-contact .contact-form-heading > p { margin:0 !important; font:400 16px/1.6 var(--san) !important; color:#5f6873 !important; }

  .ffn-demo-contact .contact-fields {
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .ffn-demo-contact .contact-form .fl { font-size: 15px !important; font-weight: 700 !important; }
  .ffn-demo-contact .contact-form .fi { font-size: 18px !important; border: 1.5px solid #0b0d101a !important; }
  .ffn-demo-contact .contact-form-foot { display: block; }
  .ffn-demo-contact .contact-form-foot button { width: 100%; }

  .ffn-demo-contact .contact-email,
  .ffn-demo-contact .contact-message {
    grid-column: 1 / -1;
  }

  .ffn-demo-contact .contact-form textarea.fi {
    min-height: 170px !important;
  }

  @media (max-width: 1023px) {
    .ffn-demo-contact .ph {
      padding: 16px 16px 0 !important;
    }

    .ffn-demo-contact .ph-in {
      padding: 32px !important;
      gap: 20px !important;
    }

    .ffn-demo-contact .ph h1 {
      max-width: none !important;
      margin: 0 !important;
      font-size: 44px !important;
      line-height: .98 !important;
    }

    .ffn-demo-contact .ph-d {
      font-size: 18px !important;
      line-height: 1.7 !important;
    }

    .ffn-demo-contact .contact-main {
      padding: 48px 0 0 !important;
    }

    .ffn-demo-contact .contact-grid {
      width: auto;
      max-width: none !important;
      margin: 0 16px;
      grid-template-columns: 1fr !important;
      gap: 32px !important;
      padding: 24px !important;
    }

    .ffn-demo-contact .contact-guide-title,
    .ffn-demo-contact .contact-form h2 {
      font-size: 28px;
    }

    .ffn-demo-contact .contact-guide-intro,
    .ffn-demo-contact .contact-form > p {
      font-size: 16px;
      line-height: 1.6;
    }

    .ffn-demo-contact .contact-note p {
      font-size: 17px !important;
      line-height: 1.7 !important;
    }

    .ffn-demo-contact .contact-note > button span {
      font-size: 19px !important;
    }

    .ffn-demo-contact .contact-form {
      padding: 28px !important;
      border: 0 !important;
    }

    .ffn-demo-contact .contact-guide-title { font-size: 32px !important; line-height: 1.02 !important; }

    .ffn-demo-contact .contact-fields {
      grid-template-columns: 1fr;
    }

    .ffn-demo-contact .contact-email,
    .ffn-demo-contact .contact-message {
      grid-column: auto;
    }
  }
</style>
