---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const broader = block?.broader || {};
const purpose = block?.purpose || {};
const standards = block?.standardsSection || {};
const readers = block?.readers || {};
const explore = block?.explore || {};
const broaderItems = Array.isArray(broader?.items) ? broader.items : [];
const questions = Array.isArray(purpose?.questions) ? purpose.questions : [];
const standardItems = Array.isArray(standards?.items) ? standards.items : [];
const accent = String(hero.headlineAccent || '').trim();
const headline = String(hero.headline || '');
const heroLead = accent && headline.endsWith(accent) ? headline.slice(0, -accent.length).trim() : headline;
---
<main class="ffn-demo about-page">
  <header class="about-hero">
    <div class="about-shell about-hero-panel">
      <div class="about-pill" data-tina-field={tinaField(hero, 'eyebrow')}><i></i>{hero.eyebrow}</div>
      <h1 data-tina-field={tinaField(hero, 'headline')}>{heroLead} {accent && <span>{accent}</span>}</h1>
      <p data-tina-field={tinaField(hero, 'lede')}>{hero.lede}</p>
    </div>
  </header>

  <section class="broader-section about-section">
    <div class="about-shell">
      <div class="broader-copy">
        <div class="about-pill" data-tina-field={tinaField(broader, 'eyebrow')}><i></i>{broader.eyebrow}</div>
        <h2 data-tina-field={tinaField(broader, 'title')}>{broader.title}</h2>
        <p data-tina-field={tinaField(broader, 'text')}>{broader.text}</p>
      </div>
      <div class="broader-image">
        <img src={broader.image} alt={broader.imageAlt || ''} data-tina-field={tinaField(broader, 'image')} />
        <div class="broader-cards">
          {broaderItems.map((item: any) => <div class="broader-card">
            <span data-tina-field={tinaField(item, 'label')}>{item.label}</span>
            <b data-tina-field={tinaField(item, 'title')}>{item.title}</b>
          </div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="purpose-section about-section">
    <div class="about-shell purpose-panel">
      <div class="purpose-copy">
        <div class="about-pill dark" data-tina-field={tinaField(purpose, 'eyebrow')}><i></i>{purpose.eyebrow}</div>
        <h2 data-tina-field={tinaField(purpose, 'title')}>{purpose.title}</h2>
        <p data-tina-field={tinaField(purpose, 'paragraphOne')}>{purpose.paragraphOne}</p>
      </div>
      <div class="questions">
        <b class="questions-title" data-tina-field={tinaField(purpose, 'questionsTitle')}>{purpose.questionsTitle}</b>
        {questions.map((item: any) => <div class="question">
          <span data-tina-field={tinaField(item, 'number')}>{item.number}</span>
          <b data-tina-field={tinaField(item, 'text')}>{item.text}</b>
        </div>)}
      </div>
    </div>
  </section>

  <section class="standards-section about-section">
    <div class="about-shell standards-panel">
      <div class="standards-intro">
        <div class="about-pill" data-tina-field={tinaField(standards, 'eyebrow')}><i></i>{standards.eyebrow}</div>
        <h2 data-tina-field={tinaField(standards, 'title')}>{standards.title}</h2>
        <p data-tina-field={tinaField(standards, 'intro')}>{standards.intro}</p>
      </div>
      <div class="standards-grid">
        {standardItems.map((item: any, index: number) => <article class:list={['standard-card', { featured: index === 0 }]}>
          <span data-tina-field={tinaField(item, 'number')}>{item.number}</span>
          <h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
          <p data-tina-field={tinaField(item, 'text')}>{item.text}</p>
        </article>)}
      </div>
      <p class="standards-note" data-tina-field={tinaField(standards, 'note')}>{standards.note}</p>
    </div>
  </section>

  <section class="readers-section about-section">
    <div class="about-shell readers-grid">
      <img src={readers.image} alt={readers.imageAlt || ''} data-tina-field={tinaField(readers, 'image')} />
      <div class="readers-copy">
        <div class="about-pill" data-tina-field={tinaField(readers, 'eyebrow')}><i></i>{readers.eyebrow}</div>
        <h2 data-tina-field={tinaField(readers, 'title')}>{readers.title}</h2>
        <p data-tina-field={tinaField(readers, 'paragraphOne')}>{readers.paragraphOne}</p>
        <p data-tina-field={tinaField(readers, 'paragraphTwo')}>{readers.paragraphTwo}</p>
      </div>
    </div>
  </section>

  <section class="explore-section about-section">
    <div class="about-shell explore-copy">
      <div class="about-pill" data-tina-field={tinaField(explore, 'eyebrow')}><i></i>{explore.eyebrow}</div>
      <h2 data-tina-field={tinaField(explore, 'title')}>{explore.title}</h2>
      <p data-tina-field={tinaField(explore, 'text')}>{explore.text}</p>
      <a href={explore.buttonLink} data-tina-field={tinaField(explore, 'buttonText')}>{explore.buttonText}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</main>

<style>
  .about-page{--about-shell:1256px;color:#171a1f!important;background:#fff!important}
  .about-shell{width:min(var(--about-shell),calc(100% - 64px));margin-inline:auto}
  .about-hero{padding:28px 0 0!important;background:#fff!important}
  .about-hero-panel{box-sizing:border-box;background:#f2f4f6;border-radius:36px;padding:72px!important;display:flex;flex-direction:column;gap:28px}
  .about-pill{display:inline-flex;align-items:center;gap:8px;background:#eff7d9;color:#496c0c;border-radius:999px;padding:7px 13px;font:800 12px/1 var(--san);letter-spacing:.06em;text-transform:uppercase}
  .about-pill i{display:block;width:7px;height:7px;border-radius:50%;background:#5b850b}
  .about-pill.dark{background:#101216;color:#fff}.about-pill.dark i{background:#c6f432}
  .about-hero h1{max-width:none!important;margin:0!important;font:800 clamp(44px,6.4vw,96px)/.98 var(--san)!important;letter-spacing:-.045em!important;color:#0b0d10!important}
  .about-hero h1 span{color:#4f7a00!important}
  .about-hero p{max-width:none;margin:0!important;color:#1f252d!important;font:400 18px/1.7 var(--san)!important}
  .about-section{padding:120px 0 0!important;background:#fff!important}
  .broader-copy{display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:900px;margin:0 auto 48px}
  .about-page h2{color:#0b0d10!important;font:800 clamp(34px,4.4vw,58px)/1.02 var(--san)!important;letter-spacing:-.04em!important}
  .broader-copy h2{margin:0 auto!important;max-width:900px}
  .broader-copy p{margin:0!important;color:#5a636e!important;font:400 18px/1.7 var(--san)!important}
  .broader-image{position:relative;height:595px;overflow:hidden;border-radius:29px;background:#dfe3e6}
  .broader-image>img{width:100%;height:100%;object-fit:cover}
  .broader-cards{position:absolute;left:30px;right:30px;bottom:30px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .broader-card{display:flex;flex-direction:column;align-items:flex-start;gap:13px;min-height:128px;padding:22px;background:rgba(255,255,255,.94);border-radius:18px}
  .broader-card span{display:inline-flex;background:#c6f432;border-radius:999px;padding:6px 12px;color:#172007;font:800 11px/1 var(--san);letter-spacing:.06em;text-transform:uppercase}
  .broader-card b{color:#0b0d10;font:800 18px/1.25 var(--san)}
  .purpose-panel{display:grid;grid-template-columns:.95fr 1.05fr;gap:72px;padding:72px;background:#c6f432;border-radius:36px}
  .purpose-copy{display:flex;flex-direction:column;gap:18px}
  .purpose-copy h2{max-width:552px;margin:0!important;font-size:58px!important}
  .purpose-copy p{max-width:470px;margin:0!important;font:400 16px/1.7 var(--san)!important;color:#384020!important}
  .questions{align-self:center}.questions-title{display:block;margin:0 0 15px;font-size:14px}
  .question{display:flex;align-items:center;gap:18px;margin:11px 0;padding:16px 20px;background:#fff;border-radius:15px}
  .question span{display:grid;place-items:center;flex:0 0 38px;height:38px;border-radius:50%;background:#0b0d10;color:#c6f432;font:800 11px var(--san)}
  .question b{font:800 18px/1.3 var(--san);color:#0b0d10}
  .standards-panel{padding:64px;background:#f2f4f6;border-radius:36px}
  .standards-intro{display:grid;grid-template-columns:1.2fr .8fr;gap:36px;align-items:end;margin-bottom:38px}
  .standards-intro .about-pill{grid-column:1/-1;justify-self:start}
  .standards-intro h2{margin:0!important;max-width:724px;font-size:58px!important}
  .standards-intro>p{margin:0!important;color:#5a636e!important;font:400 16px/1.7 var(--san)!important}
  .standards-grid{display:grid;grid-template-columns:287.5px repeat(2,minmax(0,1fr));grid-template-rows:1fr 1fr;gap:14px}
  .standard-card{min-height:205px;padding:32px;background:#fff;border-radius:19px}
  .standard-card.featured{grid-row:1/3;background:#c6f432;display:flex;flex-direction:column;justify-content:flex-end}
  .standard-card>span{display:grid;place-items:center;width:38px;height:38px;margin-bottom:42px;border-radius:50%;background:#f0f7dc;color:#4f7a00;font:800 11px var(--san)}
  .standard-card.featured>span{margin-bottom:auto;background:#0b0d10;color:#c6f432}
  .about-page .standard-card h3{margin:0 0 8px!important;color:#0b0d10!important;font:800 26px/1.05 var(--san)!important;letter-spacing:-.025em!important;text-transform:none!important}
  .about-page .standard-card.featured h3{font-size:48px!important;text-transform:none!important}
  .standard-card p{margin:0!important;color:#4f5966!important;font:400 14px/1.6 var(--san)!important}
  .standards-note{margin:34px 0 0!important;max-width:820px;color:#262b31!important;font:700 15px/1.65 var(--san)!important}
  .readers-section{padding-top:120px!important}
  .readers-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
  .readers-grid>img{width:100%;height:480px;object-fit:cover;border-radius:28px}
  .readers-copy h2{margin:0!important;font-size:58px!important}
  .readers-copy p{margin:0 0 18px!important;color:#5a636e!important;font:400 16px/1.72 var(--san)!important}
  .explore-section{padding-bottom:42px!important}
  .explore-copy{text-align:center;max-width:850px!important}
  .explore-copy h2{margin:0 auto!important;max-width:860px;font-size:58px!important}
  .explore-copy p{margin:0 auto 27px!important;max-width:780px;color:#5a636e!important;font:400 16px/1.7 var(--san)!important}
  .explore-copy a{display:inline-flex;align-items:center;gap:18px;padding:17px 26px;border-radius:12px;background:#0b0d10;color:#fff!important;text-decoration:none;font-weight:800}
  @media(max-width:1023px){
    .about-shell{width:calc(100% - 32px)}
    .about-hero{padding-top:16px!important}.about-hero-panel{padding:32px!important;border-radius:24px;gap:20px}
    .about-hero h1{margin:0!important;font-size:44px!important;line-height:.98!important}
    .about-hero p{font-size:17px!important;line-height:1.78!important}
    .about-section{padding-top:64px!important}
    .about-page h2{font-size:34px!important;line-height:1.02!important}
    .broader-copy{margin-bottom:34px}.broader-copy p{font-size:17px!important;line-height:1.75!important}.broader-copy h2{margin-top:17px!important}
    .broader-image{height:430px;border-radius:24px}.broader-image>img{position:absolute;inset:0}
    .broader-cards{inset:16px;display:flex;flex-direction:column;justify-content:flex-end;gap:12px}
    .broader-card{min-height:0;padding:19px;border-radius:17px;gap:12px}.broader-card b{font-size:17px}
    .purpose-panel{display:block;padding:32px;border-radius:24px}.purpose-copy h2{font-size:34px!important}.purpose-copy p{font-size:17px!important;line-height:1.75!important}.questions{margin-top:38px}.question{padding:17px 20px}.question b{font-size:17px}
    .standards-panel{padding:32px 28px;border-radius:24px}.standards-intro{display:block}.standards-intro h2{font-size:34px!important;margin:17px 0!important}.standards-intro>p{font-size:17px!important;line-height:1.72!important}
    .standards-grid{display:grid;grid-template-columns:1fr;grid-template-rows:auto;gap:14px}.standard-card,.standard-card.featured{grid-row:auto;min-height:0;padding:32px;display:block}.standard-card>span,.standard-card.featured>span{margin:0 0 44px}.about-page .standard-card h3{font-size:26px!important}.about-page .standard-card.featured h3{font-size:36px!important}.standard-card p{font-size:17px!important;line-height:1.7!important}.standards-note{font-size:17px!important;line-height:1.7!important}
    .readers-grid{grid-template-columns:1fr;gap:34px}.readers-grid>img{height:auto;aspect-ratio:1.12;border-radius:24px}.readers-copy h2{font-size:34px!important}.readers-copy p{font-size:17px!important;line-height:1.75!important}
    .explore-section{padding-bottom:16px!important}.explore-copy h2{font-size:34px!important}.explore-copy p{font-size:17px!important;line-height:1.75!important}.explore-copy a{padding:18px 26px}
  }
</style>
