---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const broader = block?.broader || {};
const purpose = block?.purpose || {};
const standards = block?.standardsSection || {};
const readers = block?.readers || {};
const explore = block?.explore || {};
const broaderItems = Array.isArray(broader?.items) ? broader.items : [];
const questions = Array.isArray(purpose?.questions) ? purpose.questions : [];
const standardItems = Array.isArray(standards?.items) ? standards.items : [];
const accent = String(hero.headlineAccent || '').trim();
const headline = String(hero.headline || '');
const heroLead = accent && headline.endsWith(accent) ? headline.slice(0, -accent.length).trim() : headline;
---
<main class="ffn-demo about-page">
  <section class="about-shell about-hero-wrap"><div class="about-hero-panel">
    <div class="about-pill" data-tina-field={tinaField(hero, 'eyebrow')}><i></i>{hero.eyebrow}</div>
    <h1 data-tina-field={tinaField(hero, 'headline')}>{heroLead} {accent && <span>{accent}</span>}</h1>
    <p data-tina-field={tinaField(hero, 'lede')}>{hero.lede}</p>
  </div></section>

  <section class="about-shell about-section broader-section">
    <div class="broader-copy">
      <div class="about-pill" data-tina-field={tinaField(broader, 'eyebrow')}><i></i>{broader.eyebrow}</div>
      <h2 data-tina-field={tinaField(broader, 'title')}>{broader.title}</h2>
      <p data-tina-field={tinaField(broader, 'text')}>{broader.text}</p>
    </div>
    <div class="broader-image">
      <img src={broader.image} alt={broader.imageAlt || ''} data-tina-field={tinaField(broader, 'image')} />
      <div class="broader-cards">{broaderItems.map((item: any) => <div class="broader-card">
        <span data-tina-field={tinaField(item, 'label')}>{item.label}</span>
        <b data-tina-field={tinaField(item, 'title')}>{item.title}</b>
      </div>)}</div>
    </div>
  </section>

  <section class="about-shell about-section"><div class="purpose-panel">
    <div class="purpose-copy">
      <div class="about-pill dark" data-tina-field={tinaField(purpose, 'eyebrow')}><i></i>{purpose.eyebrow}</div>
      <h2 data-tina-field={tinaField(purpose, 'title')}>{purpose.title}</h2>
      <p data-tina-field={tinaField(purpose, 'paragraphOne')}>{purpose.paragraphOne}</p>
    </div>
    <div class="questions">
      <b class="questions-title" data-tina-field={tinaField(purpose, 'questionsTitle')}>{purpose.questionsTitle}</b>
      {questions.map((item: any) => <div class="question"><span data-tina-field={tinaField(item, 'number')}>{item.number}</span><b data-tina-field={tinaField(item, 'text')}>{item.text}</b></div>)}
    </div>
  </div></section>

  <section class="about-shell about-section"><div class="standards-panel">
    <div class="standards-intro">
      <div><div class="about-pill" data-tina-field={tinaField(standards, 'eyebrow')}><i></i>{standards.eyebrow}</div><h2 data-tina-field={tinaField(standards, 'title')}>{standards.title}</h2></div>
      <p data-tina-field={tinaField(standards, 'intro')}>{standards.intro}</p>
    </div>
    <div class="standards-grid">{standardItems.map((item: any, index: number) => <article class:list={['standard-card', { featured: index === 0 }]}>
      <span data-tina-field={tinaField(item, 'number')}>{item.number}</span>
      <h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
      <p data-tina-field={tinaField(item, 'text')}>{item.text}</p>
    </article>)}</div>
    <p class="standards-note" data-tina-field={tinaField(standards, 'note')}>{standards.note}</p>
  </div></section>

  <section class="about-shell about-section"><div class="readers-grid">
    <div class="readers-image"><img src={readers.image} alt={readers.imageAlt || ''} data-tina-field={tinaField(readers, 'image')} /></div>
    <div class="readers-copy">
      <div class="about-pill" data-tina-field={tinaField(readers, 'eyebrow')}><i></i>{readers.eyebrow}</div>
      <h2 data-tina-field={tinaField(readers, 'title')}>{readers.title}</h2>
      <p data-tina-field={tinaField(readers, 'paragraphOne')}>{readers.paragraphOne}</p>
      <p data-tina-field={tinaField(readers, 'paragraphTwo')}>{readers.paragraphTwo}</p>
    </div>
  </div></section>

  <section class="about-shell about-section explore-section"><div class="explore-copy">
    <div class="about-pill" data-tina-field={tinaField(explore, 'eyebrow')}><i></i>{explore.eyebrow}</div>
    <h2 data-tina-field={tinaField(explore, 'title')}>{explore.title}</h2>
    <p data-tina-field={tinaField(explore, 'text')}>{explore.text}</p>
    <a href={explore.buttonLink} data-tina-field={tinaField(explore, 'buttonText')}>{explore.buttonText}<span aria-hidden="true">→</span></a>
  </div></section>
</main>

<style>
.about-page{--about-shell:1320px;color:#1f252d!important;background:#fff!important;font-size:18px;line-height:1.6}
.about-shell{box-sizing:border-box;width:100%;max-width:var(--about-shell);margin-inline:auto;padding-left:clamp(16px,3vw,32px);padding-right:clamp(16px,3vw,32px)}
.about-hero-wrap{padding-top:clamp(16px,2.4vw,28px)}
.about-hero-panel{background:#f2f4f6;border-radius:clamp(24px,3vw,36px);padding:clamp(32px,5vw,72px);display:flex;flex-direction:column;gap:clamp(20px,2.4vw,28px)}
.about-pill{align-self:flex-start;width:max-content;display:inline-flex;align-items:center;gap:8px;background:#eef7d6;color:#3d5e00;padding:7px 14px;border-radius:999px;font:700 13px/1.2 var(--san);letter-spacing:.08em;text-transform:uppercase}
.about-pill i{width:7px;height:7px;border-radius:50%;background:#4f7a00}.about-pill.dark{background:#0b0d10;color:#c6f432}.about-pill.dark i{background:#c6f432}
.about-hero-panel h1{width:100%;margin:0!important;color:#0b0d10!important;font:800 clamp(44px,6.4vw,96px)/.98 var(--san)!important;letter-spacing:-.045em!important}.about-hero-panel h1 span{color:#4f7a00!important}
.about-hero-panel>p{width:100%;margin:0!important;color:#1f252d!important;font:400 18px/1.7 var(--san)!important}
.about-section{padding-top:clamp(64px,8vw,120px)}
.about-page h2{margin:0!important;color:#0b0d10!important;font:800 clamp(34px,4.4vw,58px)/1.02 var(--san)!important;letter-spacing:-.035em!important;text-wrap:balance}
.broader-copy{display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:900px;margin:0 auto clamp(32px,4vw,48px)}.broader-copy .about-pill{align-self:center}.broader-copy>p{max-width:720px;margin:0!important;color:#4f5966!important;font:400 18px/1.7 var(--san)!important}
.broader-image{position:relative;overflow:hidden;border-radius:clamp(24px,3vw,36px);min-height:clamp(420px,48vw,600px);display:flex;align-items:flex-end;background:#0b0d10}.broader-image>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%}.broader-image:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0b0d1000 30%,#0b0d10cc 100%)}
.broader-cards{position:relative;z-index:1;width:100%;padding:clamp(16px,3vw,32px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px}.broader-card{background:#ffffffe6;backdrop-filter:blur(12px);border-radius:20px;padding:20px 22px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;color:#0b0d10}.broader-card span{background:#c6f432;border-radius:999px;padding:4px 12px;font:800 12px/1.6 var(--san);text-transform:uppercase;letter-spacing:.08em}.broader-card b{font:800 clamp(19px,1.7vw,22px)/1.3 var(--san);letter-spacing:-.015em}
.purpose-panel{background:#c6f432;border-radius:clamp(24px,3vw,36px);padding:clamp(32px,5vw,72px);display:flex;flex-wrap:wrap;gap:32px clamp(32px,5vw,72px);color:#0b0d10}.purpose-copy{flex:1 1 380px;display:flex;flex-direction:column;gap:18px}.purpose-copy>p{margin:0!important;color:#2e3a08!important;font:400 18px/1.7 var(--san)!important}.questions{flex:1 1 380px;display:flex;flex-direction:column;gap:12px;justify-content:center}.questions-title{font:700 15px/1.6 var(--san);color:#2e3a08}.question{display:flex;align-items:center;gap:16px;background:#fff;border-radius:18px;padding:18px 22px}.question span{display:flex;align-items:center;justify-content:center;flex:none;width:40px;height:40px;border-radius:50%;background:#0b0d10;color:#c6f432;font:800 15px var(--san)}.question b{font:800 clamp(20px,1.9vw,24px)/1.3 var(--san);letter-spacing:-.02em}
.standards-panel{background:#f2f4f6;border-radius:clamp(24px,3vw,36px);padding:clamp(28px,5vw,64px)}.standards-intro{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px 48px;margin-bottom:clamp(28px,3vw,40px)}.standards-intro>div{display:flex;flex-direction:column;gap:16px;flex:1 1 420px}.standards-intro>p{margin:0!important;flex:0 1 420px;color:#4f5966!important;font:400 18px/1.65 var(--san)!important}
.standards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.standard-card{background:#fff;border-radius:24px;padding:26px;display:flex;flex-direction:column;gap:10px}.standard-card.featured{background:#c6f432;padding:32px;grid-row:span 2;justify-content:flex-end;min-height:320px}.standard-card>span{align-self:flex-start;width:40px;height:40px;border-radius:50%;background:#eef7d6;color:#3d5e00;display:flex;align-items:center;justify-content:center;font:800 15px var(--san);margin-bottom:6px}.standard-card.featured>span{width:52px;height:52px;background:#0b0d10;color:#c6f432;margin-bottom:auto}.about-page .standard-card h3{margin:0!important;color:#0b0d10!important;font:800 26px/1.05 var(--san)!important;letter-spacing:-.025em!important;text-transform:none!important}.about-page .standard-card.featured h3{font-size:clamp(36px,3.6vw,48px)!important}.standard-card p{margin:0!important;color:#4f5966!important;font:400 17px/1.6 var(--san)!important}.standard-card.featured p{color:#2e3a08!important;font-size:19px!important}.standards-note{margin:clamp(24px,3vw,36px) 0 0!important;max-width:820px;color:#1f252d!important;font:600 18px/1.65 var(--san)!important}
.readers-grid{display:flex;flex-wrap:wrap;gap:32px clamp(32px,5vw,72px);align-items:center}.readers-image{flex:1 1 420px;position:relative;border-radius:clamp(24px,3vw,36px);overflow:hidden;aspect-ratio:5/4;background:#f2f4f6}.readers-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:78% center}.readers-copy{flex:1 1 420px;display:flex;flex-direction:column;gap:18px}.readers-copy p{margin:0!important;color:#4f5966!important;font:400 18px/1.7 var(--san)!important;text-wrap:pretty}
.explore-section{padding-bottom:0}.explore-copy{display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:860px!important}.explore-copy .about-pill{align-self:center}.explore-copy p{margin:0!important;color:#4f5966!important;font:400 18px/1.7 var(--san)!important;text-wrap:pretty}.explore-copy a{margin-top:8px;display:inline-flex;align-items:center;gap:10px;background:#0b0d10;color:#fff!important;padding:18px 28px;border-radius:16px;font-weight:700;text-decoration:none}
</style>
