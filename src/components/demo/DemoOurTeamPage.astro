---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const leadership = block?.leadership || {};
const seniorStaff = block?.seniorStaff || {};
const people = Array.isArray(leadership?.people) ? leadership.people : [];
const staff = Array.isArray(seniorStaff?.people) ? seniorStaff.people : [];
const accent = String(hero.headlineAccent || '').trim();
const headline = String(hero.headline || '');
const heroLead = accent && headline.endsWith(accent) ? headline.slice(0, -accent.length).trim() : headline;
---
<main class="ffn-demo ffn-demo-team team-page">
  <header class="team-hero">
    <div class="team-shell"><div class="team-hero-panel">
      <div class="team-pill" data-tina-field={tinaField(hero, 'eyebrow')}><i></i>{hero.eyebrow}</div>
      <h1 data-tina-field={tinaField(hero, 'headline')}>{heroLead} {accent && <span>{accent}</span>}</h1>
      <p data-tina-field={tinaField(hero, 'lede')}>{hero.lede}</p>
    </div></div>
  </header>

  <section class="team-section leadership-section">
    <div class="team-shell">
      <div class="team-pill" data-tina-field={tinaField(leadership, 'eyebrow')}><i></i>{leadership.eyebrow}</div>
      <h2 data-tina-field={tinaField(leadership, 'title')}>{leadership.title}</h2>
      <div class="leader-list">
        {people.map((person: any) => <article class="leader-card">
          <img src={person.image} alt={person.imageAlt || person.name || ''} data-tina-field={tinaField(person, 'image')} />
          <div class="leader-copy">
            <div class="person-tags">
              <span class="role" data-tina-field={tinaField(person, 'role')}>{person.role}</span>
              <span class="location" data-tina-field={tinaField(person, 'location')}>{person.location}</span>
            </div>
            <h3 data-tina-field={tinaField(person, 'name')}>{person.name}</h3>
            <p data-tina-field={tinaField(person, 'bio')}>{person.bio}</p>
          </div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="team-section staff-section">
    <div class="team-shell">
      <div class="team-pill" data-tina-field={tinaField(seniorStaff, 'eyebrow')}><i></i>{seniorStaff.eyebrow}</div>
      <h2 data-tina-field={tinaField(seniorStaff, 'title')}>{seniorStaff.title}</h2>
      <div class="staff-grid">
        {staff.map((person: any) => <article class="staff-card">
          <div class="staff-head">
            <img src={person.image} alt={person.imageAlt || person.name || ''} data-tina-field={tinaField(person, 'image')} />
            <div>
              <h3 data-tina-field={tinaField(person, 'name')}>{person.name}</h3>
              <div class="staff-meta">
                <b data-tina-field={tinaField(person, 'role')}>{person.role}</b>
                <span data-tina-field={tinaField(person, 'location')}>{person.location}</span>
              </div>
            </div>
          </div>
          <p data-tina-field={tinaField(person, 'bio')}>{person.bio}</p>
        </article>)}
      </div>
    </div>
  </section>
</main>

<style>
  .team-page{color:#1f252d!important;background:#fff!important;font-size:18px;line-height:1.6}
  .team-shell{box-sizing:border-box;width:100%;max-width:1320px;margin-inline:auto;padding-left:clamp(16px,3vw,32px);padding-right:clamp(16px,3vw,32px)}
  .team-hero{padding:clamp(16px,2.4vw,28px) 0 0!important;background:#fff!important}
  .team-hero-panel{background:#f2f4f6;border-radius:clamp(24px,3vw,36px);padding:clamp(32px,5vw,72px)!important;display:flex;flex-direction:column;gap:clamp(20px,2.4vw,28px)}
  .team-pill{align-self:flex-start;width:max-content;display:inline-flex;align-items:center;gap:8px;background:#eef7d6;color:#3d5e00;border-radius:999px;padding:7px 14px;font:700 13px/1.2 var(--san);letter-spacing:.08em;text-transform:uppercase}
  .team-pill i{display:block;width:7px;height:7px;border-radius:50%;background:#4f7a00}
  .team-hero h1{width:100%;max-width:none!important;margin:0!important;font:800 clamp(44px,6.4vw,96px)/.98 var(--san)!important;letter-spacing:-.045em!important;color:#0b0d10!important}
  .team-hero h1 span{color:#4f7a00!important}.team-hero p{width:100%;max-width:none;margin:0!important;color:#1f252d!important;font:400 18px/1.7 var(--san)!important}
  .team-section{padding:calc(clamp(64px,8vw,120px) - 2.703125px) 0 0!important;background:#fff!important}
  .team-section h2{margin:16px 0 clamp(28px,3vw,40px)!important;color:#0b0d10!important;font:800 clamp(32px,4vw,52px)/1.02 var(--san)!important;letter-spacing:-.035em!important}
  .leader-list{display:flex;flex-direction:column;gap:20px}
  .leader-card{background:#f2f4f6;border-radius:clamp(24px,3vw,32px);overflow:hidden;display:flex;flex-wrap:wrap}
  .leader-card>img{flex:1 1 300px!important;width:auto!important;height:clamp(320px,32vw,440px)!important;min-height:clamp(320px,32vw,440px)!important;max-height:440px!important;object-fit:cover;object-position:center 20%;background:#e3e7eb}
  .leader-copy{flex:1.6 1 420px;min-width:0;padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;justify-content:center;gap:16px}
  .person-tags{display:flex;flex-wrap:wrap;gap:8px;margin:0}.person-tags span{display:inline-flex;border-radius:999px;padding:6px 14px;font:600 13px/1.6 var(--san)}
  .person-tags .role{background:#c6f432;color:#0b0d10;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.person-tags .location{background:#fff;color:#4f5966}
  .team-page .leader-copy h3{margin:0!important;color:#0b0d10!important;font:800 clamp(34px,3.8vw,52px)/1 var(--san)!important;letter-spacing:-.035em!important;text-transform:none!important}
  .leader-copy p{margin:0!important;color:#4f5966!important;font:400 18px/1.7 var(--san)!important;text-wrap:pretty}
  .staff-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:20px}
  .staff-card{background:#fff;border:1px solid #0b0d101a;border-radius:28px;padding:clamp(22px,2.6vw,32px);display:flex;flex-direction:column;gap:18px}
  .staff-head{display:flex;align-items:center;gap:18px}.staff-head img{flex:none;width:clamp(72px,7vw,96px);height:clamp(72px,7vw,96px);border-radius:50%;object-fit:cover;background:#f2f4f6}
  .team-page .staff-card h3{margin:0!important;color:#0b0d10!important;font:800 clamp(24px,2.4vw,30px)/1.05 var(--san)!important;letter-spacing:-.025em!important;text-transform:none!important}
  .staff-meta{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:6px;font:400 15px/1.3 var(--san);color:#5f6873}.staff-meta b{color:#4f7a00}
  .staff-card>p{margin:0!important;color:#4f5966!important;font:400 17px/1.7 var(--san)!important;text-wrap:pretty}
  @media(max-width:700px){.leader-card{display:block}.leader-card>img{width:100%;min-height:320px;aspect-ratio:1.1}.leader-copy{padding:28px}.staff-grid{grid-template-columns:1fr}}
</style>
