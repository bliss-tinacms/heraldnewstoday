---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = {} } = Astro.props;
---
<main class="ffn-demo ffn-demo-404">
  <section class="not-found"><div class="w"><div class="not-found-panel">
    <div class="not-found-code" aria-label="Error 404"><span>4</span><em>0</em><span>4</span></div>
    <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
    <p data-tina-field={tinaField(data, 'description')}>{data.description}</p>
    <a href={data.buttonHref || '/'} data-tina-field={tinaField(data, 'buttonText')}>{data.buttonText} →</a>
  </div></div></section>
</main>

<style>
  .ffn-demo-404 .not-found {
    padding: 28px 0 0;
  }

  .ffn-demo-404 .not-found > .w {
    max-width: 1256px;
    padding: 0 !important;
  }

  .ffn-demo-404 .not-found-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding: clamp(72px, 7vw, 112px) 72px;
    border-radius: 36px;
  }

  .ffn-demo-404 .not-found-code {
    font-size: clamp(120px, 22vw, 300px);
    line-height: 1;
    letter-spacing: -.06em;
  }

  .ffn-demo-404 .not-found-panel h1 {
    width: 100%;
    max-width: none;
    margin: 0;
    font-size: clamp(44px, 6.4vw, 96px);
    line-height: .98;
    letter-spacing: -.045em;
  }

  .ffn-demo-404 .not-found-panel p { width: 100%; max-width: none; margin: 0; font-size: 18px; line-height: 1.7; }
  .ffn-demo-404 .not-found-panel > a { margin-top: 6px; padding: 18px 28px !important; border-radius: 16px !important; font-size: 17px; }

  @media (max-width: 1023px) {
    .ffn-demo-404 .not-found {
      padding: 16px 16px 0;
    }

    .ffn-demo-404 .not-found-panel {
      gap: 18px;
      padding: 40px 32px;
      border-radius: 24px;
    }

    .ffn-demo-404 .not-found-code {
      font-size: 120px;
    }

    .ffn-demo-404 .not-found-panel h1 {
      max-width: none !important;
      margin: 0;
      font-size: 44px;
    }

    .ffn-demo-404 .not-found-panel > a {
      padding: 18px 28px !important;
    }
  }
</style>
