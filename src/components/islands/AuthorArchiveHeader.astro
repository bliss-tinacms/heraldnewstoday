---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsUser } from '../../lib/data';

interface Props {
  user?: CmsUser | null;
}

const { user = null } = Astro.props;
const authorName = String(user?.name || 'Author');
const initials = authorName.split(/\s+/).filter(Boolean).slice(0, 2).map((part: string) => part[0]?.toUpperCase()).join('') || 'A';
---

<header class="author-heading">
  <div class="author-heading__inner">
    <div class="author-heading__portrait" data-tina-field={user ? tinaField(user, 'avatar') : undefined}>
      {user?.avatar
        ? <img src={user.avatar} alt={authorName} width="220" height="220" />
        : <span aria-hidden="true">{initials}</span>}
    </div>
    <div class="author-heading__copy">
      {user?.role && <p class="author-heading__role" data-tina-field={tinaField(user, 'role')}>{user.role}</p>}
      <h1 data-tina-field={user ? tinaField(user, 'name') : undefined}>{authorName}</h1>
      {user?.bio && <p class="author-heading__bio" data-tina-field={tinaField(user, 'bio')}>{user.bio}</p>}
    </div>
  </div>
</header>

<style>
  .author-heading{padding:28px 32px 0;background:#fff;color:#0b0d10}
  .author-heading__inner{display:grid;grid-template-columns:220px 1fr;align-items:center;gap:56px;max-width:1256px;margin:0 auto;padding:72px;background:#f2f4f6;border-radius:36px}
  .author-heading__portrait{width:220px;height:220px;border-radius:50%;overflow:hidden;background:#c6f432;display:grid;place-items:center;font:800 48px/1 var(--san,'Plus Jakarta Sans',sans-serif);color:#0b0d10}
  .author-heading__portrait img{width:100%;height:100%;display:block;object-fit:cover}
  .author-heading__copy{display:flex;flex-direction:column;gap:16px}
  .author-heading__role{align-self:flex-start;display:inline-flex;margin:0;padding:7px 14px;border-radius:999px;background:#c6f432;color:#0b0d10;font:800 12px/1 var(--san,'Plus Jakarta Sans',sans-serif);letter-spacing:.07em;text-transform:uppercase}
  h1{margin:0;font:800 clamp(44px,6.4vw,96px)/.98 var(--san,'Plus Jakarta Sans',sans-serif);letter-spacing:-.045em;color:#0b0d10}
  .author-heading__bio{max-width:830px;margin:0;color:#5f6873;font:400 16px/1.75 var(--san,'Plus Jakarta Sans',sans-serif)}
  @media(max-width:700px){
    .author-heading{padding:16px 16px 0}
    .author-heading__inner{grid-template-columns:1fr;gap:28px;padding:32px;border-radius:24px}
    .author-heading__portrait{width:140px;height:140px}
    .author-heading__role{margin:0}
    h1{font-size:44px;line-height:.98;margin:0}
    .author-heading__bio{font-size:18px;line-height:1.72}
  }
</style>
