  .ah-au{margin:0 10px 0 0;padding:0}.ah-an{font:800 13px/1.2 var(--san,'Plus Jakarta Sans',sans-serif);text-transform:none;letter-spacing:0}.ah-an a{color:#0b0d10;border:0;text-decoration:none}.ah-ar{margin-top:3px;color:#5f6873;font-size:11px;line-height:1.2}
  .ah-dt{display:flex;gap:7px;color:#4f5966;font:600 11px/1.2 var(--san,'Plus Jakarta Sans',sans-serif);text-align:left;text-transform:none;letter-spacing:0}.ah-dt span{display:inline-flex;padding:8px 12px;border-radius:999px;background:#fff}.ah-dt br{display:none}
  .bd{padding:72px 32px 78px;background:#fff}.bd-in{display:grid;grid-template-columns:minmax(0,760px) minmax(0,424px);column-gap:72px;row-gap:34px;max-width:1256px;padding:0;margin:0 auto;align-items:start}
  .li{grid-column:1;grid-row:1;margin:0;border-radius:22px;overflow:hidden}.li img{width:100%;aspect-ratio:1.78;display:block;object-fit:cover}.rl{grid-column:2;grid-row:1/span 2;position:static;display:flex;flex-direction:column;gap:24px}
  .rc{border:0;border-radius:20px;background:#f2f4f6;padding:24px}.rc-t{border:0;padding:0 0 15px;background:transparent;color:#0b0d10;font:800 16px/1.2 var(--san,'Plus Jakarta Sans',sans-serif);letter-spacing:-.02em;text-transform:none}.rc-b{padding:0}.tc{display:grid;grid-template-columns:34px 1fr;gap:9px;align-items:center;margin-top:7px;padding:10px 12px;border:0;border-radius:11px;background:#fff;text-decoration:none}.tc-n{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:#c6f432;color:#0b0d10;font-size:11px;font-weight:800}.tc-h{color:#1f252d;font:600 12px/1.25 var(--san,'Plus Jakarta Sans',sans-serif);text-transform:none}
  .standards-card{display:flex;flex-direction:column;align-items:flex-start;padding:28px;border-radius:20px;background:#0b0d10;color:#fff;text-decoration:none}.standards-card>span{padding:6px 11px;border-radius:999px;background:#c6f432;color:#0b0d10;font-size:10px;font-weight:800;text-transform:uppercase}.standards-card strong{margin-top:15px;color:#fff;font-size:26px;line-height:1.05}.standards-card p{margin:10px 0 18px;color:#c7cdd4;font-size:12px;line-height:1.55}.standards-card b{padding:12px 14px;border-radius:9px;background:#c6f432;color:#0b0d10;font-size:11px}
  .pr{grid-column:1;grid-row:2;color:#1f252d}:global(.pr p){margin:0 0 24px;color:#1f252d;font:400 18px/1.8 var(--san,'Plus Jakarta Sans',sans-serif)}:global(.pr>div>p:first-of-type){color:#0b0d10;font-size:20px;font-weight:600}:global(.pr h2){margin:38px 0 15px;padding:0;border:0;color:#0b0d10;font:800 clamp(26px,2.6vw,34px)/1.15 var(--san,'Plus Jakarta Sans',sans-serif);letter-spacing:-.03em;text-transform:none}:global(.pr h3){margin:32px 0 13px;color:#0b0d10;font:800 22px/1.12 var(--san,'Plus Jakarta Sans',sans-serif);text-transform:none}:global(.pr ul),:global(.pr ol){margin:0 0 26px;padding-left:22px;list-style:initial}:global(.pr li){padding:3px 0;border:0;color:#1f252d;font-size:18px;line-height:1.7}:global(.pr ul li::before),:global(.pr ol li::before){display:none}:global(.pr blockquote){margin:30px 0;padding:28px 32px;border-radius:18px;background:#c6f432}:global(.pr blockquote p){color:#0b0d10;font-size:22px;font-weight:800;line-height:1.2;text-transform:none}
