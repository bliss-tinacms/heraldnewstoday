  .mo{max-width:1256px;margin:0 auto 36px;padding:48px 56px 54px;border:0;border-radius:28px;background:#f2f4f6}.mo>.w{max-width:none;padding:0}.mo .h2{margin:0;color:#0b0d10;font:800 38px/1 var(--san,'Plus Jakarta Sans',sans-serif);letter-spacing:-.04em;text-transform:none}.mo-g{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:28px}.mi{display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#fff;color:#0b0d10;text-decoration:none}.mi-img{width:100%;aspect-ratio:1.45;object-fit:cover}.mi-c{flex:1;padding:18px 20px 20px;border:0}.mi-k{margin:0 0 10px}.mi-k.category-badges{gap:5px}.mi-k.category-badges span{padding:5px 9px;background:#eef7d6;color:#4f7a00;font-size:9px}.mi-h{color:#0b0d10;font-size:18px;font-weight:800;line-height:1.15;text-transform:none;letter-spacing:-.02em}
