    .bd{padding:40px 16px 48px}.bd-in{display:flex;flex-direction:column;gap:24px}.li{order:0;width:100%;border-radius:22px}.li img{aspect-ratio:1.58}.rl{display:contents}.toc{order:1;width:100%;padding:24px;border-radius:20px}.pr{order:2;width:100%}.standards-card{order:3;width:100%;margin-top:18px;padding:26px;border-radius:22px}
    :global(.pr p){font-size:18px;line-height:1.78;margin-bottom:24px}:global(.pr>div>p:first-of-type){font-size:19px}:global(.pr h2){font-size:27px;margin-top:40px}:global(.pr h3){font-size:23px}:global(.pr li){font-size:18px}
    .corr{padding:22px}.corr>img,.corr-avatar{width:88px;height:88px}.corr-b p{font-size:16px!important}.mo{margin:0 16px 36px;padding:32px 28px 34px;border-radius:22px}.mo .h2{font-size:31px}.mo-g{grid-template-columns:1fr;gap:22px}.mi-img{aspect-ratio:1.35}.mi-h{font-size:21px}
  }
</style>
