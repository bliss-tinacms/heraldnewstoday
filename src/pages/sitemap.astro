---
import Base from '../layouts/Base.astro';
import { getConfig, listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';

export const prerender = false;

const pages = await listPages();
const posts = await listBlogs();
const config = (await getConfig()).data?.config ?? null;
const siteName = config?.seo?.title || 'Herald News Today';

const title = `Sitemap | ${siteName}`;
const description = `Browse the public pages and latest reporting published by ${siteName}.`;

function cleanTitle(value: unknown, fallback = 'Untitled') {
  return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}

function withTrailingSlash(value: string) {
  if (!value || value === '/') return '/';
  const normalized = value.startsWith('/') ? value : '/' + value;
  return normalized.endsWith('/') ? normalized : normalized + '/';
}

function pageUrl(page: any) {
  const filename = page?._sys?.filename || '';
  if (filename === 'home') return '/';
  return withTrailingSlash(getPageRouteSlug(page) || filename);
}

function postUrl(post: any) {
  return withTrailingSlash(getBlogPermalink(post));
}

function isHiddenPage(page: any) {
  const filename = page?._sys?.filename || '';
  const url = pageUrl(page);
  return Boolean(
    page?.draft ||
    page?.seo?.noindex ||
    filename === '404' ||
    filename === 'sitemap' ||
    url === '/sitemap/'
  );
}

function isHiddenPost(post: any) {
  return Boolean(post?.draft || post?.seo?.noindex);
}

type SitemapLink = { title: string; url: string };
type SitemapPostLink = SitemapLink & { date: Date | null };

const pageLinks: SitemapLink[] = (pages as any[])
  .filter((page: any) => !isHiddenPage(page))
  .map((page: any): SitemapLink => ({
    title: cleanTitle(page.title || page.seoTitle || page.seo?.metaTitle, page?._sys?.filename || 'Page'),
    url: pageUrl(page),
  }))
  .sort((a: SitemapLink, b: SitemapLink) => {
    if (a.url === '/') return -1;
    if (b.url === '/') return 1;
    return a.title.localeCompare(b.title);
  });

const postLinks: SitemapPostLink[] = (posts as any[])
  .filter((post: any) => !isHiddenPost(post))
  .map((post: any): SitemapPostLink => ({
    title: cleanTitle(post.title || post.seo?.metaTitle, post?._sys?.filename || 'Story'),
    url: postUrl(post),
    date: post.pubDate ? new Date(post.pubDate) : null,
  }))
  .sort((a: SitemapPostLink, b: SitemapPostLink) => Number(b.date || 0) - Number(a.date || 0));

---

<Base
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  canonicalUrl="/sitemap/"
>
  <main class="ffn-demo ffn-demo-sitemap" aria-labelledby="sitemap-title">
    <header class="ph sitemap-simple-hero"><div class="w"><h1 id="sitemap-title">Sitemap</h1></div></header>
    <section class="sitemap-simple"><div class="w sitemap-simple-grid">
      <section class="sitemap-simple-col" aria-labelledby="sitemap-pages-title"><h2 id="sitemap-pages-title">Pages</h2>
        {pageLinks.length > 0 ? <ul>{pageLinks.map((item: SitemapLink) => <li><a href={item.url}><span>{item.title}</span><b aria-hidden="true">→</b></a></li>)}</ul> : <p>No public pages found.</p>}
      </section>
      <section class="sitemap-simple-col" aria-labelledby="sitemap-posts-title"><h2 id="sitemap-posts-title">Posts</h2>
        {postLinks.length > 0 ? <ul>{postLinks.map((item: SitemapPostLink) => <li><a href={item.url}><span>{item.title}</span><b aria-hidden="true">→</b></a></li>)}</ul> : <p>No published stories found.</p>}
      </section>
    </div></section>
  </main>
</Base>

<style>
  .ffn-demo-sitemap .sitemap-simple-hero {
    padding: 28px 0 0 !important;
  }

  .ffn-demo-sitemap .sitemap-simple-hero > .w {
    max-width: 1256px !important;
    padding: 72px !important;
  }

  .ffn-demo-sitemap .sitemap-simple-hero h1 {
    max-width: none !important;
    font-size: clamp(44px, 6.4vw, 96px) !important;
    line-height: .98 !important;
  }

  .ffn-demo-sitemap .sitemap-simple {
    padding: 72px 0 0 !important;
  }

  .ffn-demo-sitemap .sitemap-simple-grid {
    max-width: 1256px !important;
    grid-template-columns: 1fr 1fr;
    gap: 48px clamp(40px, 6vw, 96px);
    padding: 0 !important;
  }

  .ffn-demo-sitemap .sitemap-simple-col { display:flex; flex-direction:column; gap:12px; }

  .ffn-demo-sitemap .sitemap-simple-col h2 {
    margin: 0;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .ffn-demo-sitemap .sitemap-simple-col a {
    padding: 16px 0;
    color: #1f252d;
    font-size: 18px;
    line-height: 1.5;
    font-weight: 600;
  }

  .ffn-demo-sitemap .sitemap-simple-col a span {
    color: inherit;
    font-size: inherit;
  }

  .ffn-demo-sitemap .sitemap-simple-col a b {
    color: #4f7a00;
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .ffn-demo-sitemap .sitemap-simple-hero {
      padding: 16px !important;
    }

    .ffn-demo-sitemap .sitemap-simple-hero > .w {
      padding: 32px !important;
    }

    .ffn-demo-sitemap .sitemap-simple-hero h1 {
      font-size: 44px !important;
    }

    .ffn-demo-sitemap .sitemap-simple {
      padding: 40px 16px 0 !important;
    }

    .ffn-demo-sitemap .sitemap-simple-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .ffn-demo-sitemap .sitemap-simple-col h2 {
      margin: 0;
      font-size: 26px;
    }

    .ffn-demo-sitemap .sitemap-simple-col a {
      min-height: 0;
      padding: 16px 0;
      font-size: 18px;
    }
  }
</style>
