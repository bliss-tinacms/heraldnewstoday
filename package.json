{
  "name": "heraldnewstoday",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm validate:starter && tinacms dev -c \"astro dev\"",
    "start": "node ./app.mjs",
    "build": "pnpm validate:site && node scripts/tina-build-safe.mjs",
    "build:local": "pnpm validate:starter && node scripts/tina-build-safe.mjs --local",
    "sanitize:generated": "node scripts/sanitize-generated-client.mjs",
    "site:provision": "node scripts/provision-site.mjs",
    "validate:starter": "node scripts/validate-starter.mjs",
    "validate:site": "node scripts/validate-starter.mjs --runtime && node scripts/test-view-frontend-route.mjs && node scripts/test-route-aliases.mjs",
    "test:frontend-route": "node scripts/test-view-frontend-route.mjs",
    "test:route-aliases": "node scripts/test-route-aliases.mjs",
    "build:search": "tinacms search-index",
    "preview": "astro preview",
    "astro": "astro",
    "permalink:sync": "node scripts/sync-permalinks-to-filenames.mjs",
    "permalink:watch": "node scripts/watch-permalinks-to-filenames.mjs",
    "tina:fullcheck": "python3 scripts/tina-fullcheck.py",
    "astro:demo-lock": "node scripts/validate-demo-lock.mjs",
    "astro:demo-lock:negative": "node scripts/test-demo-lock-negative.mjs",
    "publisher:admin-gate": "node scripts/publisher-admin-gate.mjs",
    "menu:verify": "node scripts/verify-responsive-menu.mjs",
    "menu:verify:negative": "node scripts/test-responsive-menu-negative.mjs",
    "visual:capture": "node scripts/capture-demo-lock.mjs",
    "astro:demo-lock:preflight": "node scripts/validate-demo-lock-preflight.mjs",
    "astro:demo-lock:preflight:negative": "node scripts/test-demo-lock-preflight-negative.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/node": "^10.1.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.5.1",
    "@tinacms/auth": "^1.1.3",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next-tinacms-cloudinary": "^27.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tinacms": "^3.14.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^2.6.1",
    "@tinacms/graphql": "^2.4.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.56.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
